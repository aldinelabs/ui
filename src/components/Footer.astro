---
import Mail from '@lucide/astro/icons/mail';
import { chrome, localeFromUrl, localize } from '../i18n';
import { container } from '../ui';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

interface FooterLink {
	href: string;
	label: string;
}

interface Props {
	/** Link columns on the right. */
	columns: { title: string; links: FooterLink[] }[];
	/** Contact lines under the logo. */
	contacts: { href: string; label: string; name: string; icon: 'github' | 'x' | 'mail' }[];
	/** Name shown after the copyright sign. */
	org: string;
	/** Filing number linked to the registry, when the site needs one. */
	icp?: { number: string; href: string };
	/** Logo files, when the site keeps them elsewhere than `/brand/`. */
	logo?: { light?: string; dark?: string; alt?: string };
}

const { columns, contacts, org, icp, logo } = Astro.props;
const locale = localeFromUrl(Astro.url);
const text = chrome(locale);
---

<footer class="mt-32 border-t">
	<div class:list={[container, 'grid gap-10 py-12 sm:grid-cols-[1fr_auto]']}>
		<div class="flex flex-col items-start gap-6">
			<a href={localize('/', locale)} aria-label={text.home} class="flex rounded-lg outline-none focus-visible:ring-3 focus-visible:ring-ring/30">
				<Logo class="h-7" {...logo} />
			</a>
			<ul aria-label={text.contact} class="flex flex-col gap-2 text-sm">
				{
					contacts.map((contact) => (
						<li>
							<a
								href={contact.href}
								aria-label={`${contact.name}: ${contact.label}`}
								class="inline-flex items-center gap-2 text-muted-foreground transition-colors hover:text-foreground"
								{...(contact.icon === 'mail' ? {} : { target: '_blank', rel: 'noopener' })}
							>
								{contact.icon === 'github' && (
									<svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true">
										<path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.29-1.69-1.29-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.71 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.78 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
									</svg>
								)}
								{contact.icon === 'x' && (
									<svg viewBox="0 0 24 24" class="size-3.5" fill="currentColor" aria-hidden="true">
										<path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.67l7.73-8.84L1.25 2.25h6.83l4.71 6.23 5.45-6.23Zm-1.16 17.52h1.83L7.08 4.13H5.12l11.96 15.64Z" />
									</svg>
								)}
								{contact.icon === 'mail' && <Mail class="size-4" aria-hidden="true" />}
								{contact.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
		<div class="grid grid-cols-2 gap-x-16 gap-y-10 sm:grid-cols-3">
			{
				columns.map((column) => (
					<div class="flex flex-col gap-3 text-sm">
						<p class="font-medium">{column.title}</p>
						<ul class="flex flex-col gap-2">
							{column.links.map((link) => (
								<li>
									<a href={link.href} class="text-muted-foreground transition-colors hover:text-foreground">
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>
	<div class:list={[container, 'flex items-center justify-between gap-4 pb-10 text-sm text-muted-foreground']}>
		<p class="flex flex-wrap gap-x-4 gap-y-1">
			<span>© {new Date().getFullYear()} {org}</span>
			{icp && <a href={icp.href} target="_blank" rel="noopener" class="transition-colors hover:text-foreground">{icp.number}</a>}
		</p>
		<ThemeToggle />
	</div>
</footer>
