---
import '../styles.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { defaultLocale, languageTag, localeFromUrl, locales, localize, type Locale } from '../i18n';

interface Props {
	title: string;
	description: string;
	/** Name of the site, shown after the page title and in structured data. */
	siteTitle: string;
	/** Share image path, relative to the site. */
	image?: string;
	type?: 'website' | 'article';
	/** This page in each locale. */
	alternates: Partial<Record<Locale, string>>;
	noindex?: boolean;
	article?: { published: Date; modified?: Date; section: string; author: string };
	/** Publisher of the site, for structured data. */
	organization?: { name: string; alternateName?: string; logo?: string; email?: string; github?: string; twitter?: string };
	/** Feed of the site, per locale, as a root-relative path. */
	rss?: { title: string; href: string };
	/** Sitemap index; pass `false` for a site without one. */
	sitemap?: string | false;
	/** Favicons for light and dark browser themes. */
	icons?: { light: string; dark: string };
}

const {
	title,
	description,
	siteTitle,
	image = '/brand/share-light.png',
	type = 'website',
	alternates,
	noindex = false,
	article,
	organization: org,
	rss,
	sitemap = '/sitemap-index.xml',
	icons = { light: '/favicon.svg', dark: '/brand/favicon-dark.svg' },
} = Astro.props;
const organization = org;
const locale = localeFromUrl(Astro.url);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = title === siteTitle ? title : `${title} · ${siteTitle}`;
const languages = Object.entries(alternates) as [Locale, string][];
const imageURL = new URL(image, Astro.site);
const ogLocale = (l: Locale) => languageTag[l].replace('-', '_');

// Structured data: who publishes the site on every page, and the article itself on article pages.
const home = new URL(localize('/', locale), Astro.site).href;
const publisher = org
	? {
			'@type': 'Organization',
			'@id': new URL('/#organization', Astro.site).href,
			name: org.name,
			...(org.alternateName ? { alternateName: org.alternateName } : {}),
			url: home,
			...(org.logo ? { logo: new URL(org.logo, Astro.site).href } : {}),
			...(org.email ? { email: org.email } : {}),
			sameAs: [org.github, org.twitter].filter(Boolean),
		}
	: undefined;
const graph: Record<string, unknown>[] = [
	...(publisher ? [publisher] : []),
	{
		'@type': 'WebSite',
		'@id': new URL(`${localize('/', locale)}#website`, Astro.site).href,
		name: siteTitle,
		url: home,
		inLanguage: languageTag[locale],
		...(publisher ? { publisher: { '@id': publisher['@id'] } } : {}),
	},
];
if (article)
	graph.push({
		'@type': 'BlogPosting',
		'@id': `${canonicalURL.href}#article`,
		mainEntityOfPage: canonicalURL.href,
		headline: title,
		description,
		image: imageURL.href,
		datePublished: article.published.toISOString(),
		dateModified: (article.modified ?? article.published).toISOString(),
		articleSection: article.section,
		inLanguage: languageTag[locale],
		author: publisher && article.author === org?.name ? { '@id': publisher['@id'] } : { '@type': 'Person', name: article.author },
		...(publisher ? { publisher: { '@id': publisher['@id'] } } : {}),
	});
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
<link rel="icon" type="image/svg+xml" href={icons.light} media="(prefers-color-scheme: light)" />
<link rel="icon" type="image/svg+xml" href={icons.dark} media="(prefers-color-scheme: dark)" />
{sitemap && <link rel="sitemap" href={sitemap} />}
{rss && <link rel="alternate" type="application/rss+xml" title={rss.title} href={new URL(rss.href, Astro.site)} />}
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, follow" />}
{
	languages.length > 1 &&
		languages.map(([l, href]) => (
			<link rel="alternate" hreflang={languageTag[l]} href={new URL(href, Astro.site)} data-locale={l} data-path={href} />
		))
}
{languages.length > 1 && alternates[defaultLocale] && <link rel="alternate" hreflang="x-default" href={new URL(alternates[defaultLocale], Astro.site)} />}
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0c0c09" media="(prefers-color-scheme: dark)" />

<title>{pageTitle}</title>
<meta name="title" content={pageTitle} />
<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:locale" content={ogLocale(locale)} />
{languages.filter(([l]) => l !== locale).map(([l]) => <meta property="og:locale:alternate" content={ogLocale(l)} />)}
<meta property="og:site_name" content={siteTitle} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
{
	article && (
		<>
			<meta property="article:published_time" content={article.published.toISOString()} />
			{article.modified && <meta property="article:modified_time" content={article.modified.toISOString()} />}
			<meta property="article:section" content={article.section} />
			<meta property="article:author" content={article.author} />
		</>
	)
}
<meta name="twitter:card" content="summary_large_image" />
{organization?.twitter && <meta name="twitter:site" content={`@${new URL(organization.twitter).pathname.slice(1)}`} />}
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageURL} />

<script type="application/ld+json" set:html={jsonLd} />

<script is:inline define:vars={{ pageLocale: locale, supported: locales }}>
	(() => {
		// Language choice, before first paint. A locale picked with the language switch is
		// stored and always wins. Without one, the first supported language in the
		// browser's preferences picks the locale. Either way, go to this page's version in
		// that locale when one exists (from the hreflang alternates above). Crawlers are
		// never redirected, so every language version stays indexable.
		if (navigator.webdriver || /bot|crawl|spider|slurp|preview|facebookexternalhit/i.test(navigator.userAgent)) return;
		let preferred = null;
		try {
			preferred = localStorage.getItem('locale');
		} catch {}
		if (!supported.includes(preferred)) {
			preferred = null;
			for (const tag of navigator.languages || [navigator.language]) {
				const base = String(tag).toLowerCase().split('-')[0];
				if (supported.includes(base)) {
					preferred = base;
					break;
				}
			}
		}
		if (!preferred || preferred === pageLocale) return;
		const target = document.querySelector(`link[rel="alternate"][data-locale="${preferred}"]`);
		const path = target && target.getAttribute('data-path');
		if (path && path !== location.pathname) location.replace(path + location.search + location.hash);
	})();
</script>

<script is:inline>
	(() => {
		// Everything that affects first paint is decided here, before the body renders.
		const read = (key) => {
			try {
				return localStorage.getItem(key);
			} catch {
				return null;
			}
		};
		const stored = read('theme');
		document.documentElement.classList.add('js');
		const media = matchMedia('(prefers-color-scheme: dark)');
		const apply = (choice) => {
			const dark = choice === 'dark' || (choice !== 'light' && media.matches);
			document.documentElement.classList.toggle('dark', dark);
			document.documentElement.dataset.theme = choice || 'system';
		};
		apply(stored);
		media.addEventListener('change', () => apply(document.documentElement.dataset.theme));
		window.__setTheme = (choice) => {
			try {
				choice === 'system' ? localStorage.removeItem('theme') : localStorage.setItem('theme', choice);
			} catch {}
			apply(choice);
		};
	})();
</script>
