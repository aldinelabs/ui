{
  "name": "@aldine/ui",
  "version": "0.2.0",
  "description": "Shared Astro layout, header, footer and theme for Aldine Labs sites.",
  "type": "module",
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    "./styles.css": "./src/styles.css",
    "./i18n": "./src/i18n.ts",
    "./ui": "./src/ui.ts",
    "./layouts/*.astro": "./src/layouts/*.astro",
    "./components/*.astro": "./src/components/*.astro",
    "./plugins/rehype-alerts.mjs": {
      "types": "./src/plugins/rehype-alerts.d.mts",
      "default": "./src/plugins/rehype-alerts.mjs"
    }
  },
  "peerDependencies": {
    "@fontsource-variable/inter": ">=5",
    "@fontsource-variable/jetbrains-mono": ">=5",
    "@lucide/astro": ">=1",
    "@tailwindcss/vite": ">=4",
    "astro": ">=7",
    "tailwindcss": ">=4"
  }
}
